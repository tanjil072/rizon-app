{
  "expo": {
    "name": "Rizon",
    "slug": "rizon-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/rizon.svg",
    "scheme": ["rizon", "rizonapp"],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rizon.app",
      "associatedDomains": ["applinks:localhost:8080", "applinks:*.rizon.app"]
    },
    "android": {
      "package": "com.rizon.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFF13",
        "foregroundImage": "./assets/images/rizon_logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "*.rizon.app",
              "pathPattern": "/auth"
            },
            {
              "scheme": "rizon"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/rizon.svg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/rizon_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
